# Postgres — Neon recommended for prod, local Postgres for dev
DATABASE_URL=postgres://USER:PASSWORD@HOST/db?sslmode=require

# Auth.js — generate a random 32+ char secret: openssl rand -base64 32
AUTH_SECRET=

# Google OAuth (https://console.cloud.google.com/apis/credentials)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Public URL (Auth.js trusted host)
AUTH_URL=http://localhost:3000

# Vercel Blob — provisioned automatically by Vercel; for local dev:
#   vercel link && vercel env pull .env.local
BLOB_READ_WRITE_TOKEN=

# Garmin Connect Developer Program (https://developer.garmin.com)
# Requires application approval. Leave blank until approved — the Connect
# button will show a "Pending" state.
GARMIN_CONSUMER_KEY=
GARMIN_CONSUMER_SECRET=
